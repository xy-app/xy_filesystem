{
  "plugin_id": "xy_filesystem",
  "name": "文件与压缩包管理 (File & Archive)",
  "version": "0.53.0",
  "group": "Filesystem",
  "group_icon": "📁",
  "description": "提供文件与文件夹的新建、复制、移动、安全删除/回收站、占用检测、大文本读写、7z/Zip 打包解压及文件夹监视功能",
  "actions": [
    {
      "tag": "CompressFile",
      "display_name": "压缩/解压归档文件 (CompressFile)",
      "icon": "🗜️",
      "platforms": "All",
      "description": "对文件或文件夹进行 7z/Zip/Tar 格式的高压缩率打包或一键解压",
      "keywords": [
        "filesystem",
        "compress",
        "decompress",
        "zip",
        "tar",
        "压缩",
        "解压"
      ],
      "fields": [
        {
          "name": "source",
          "display_name": "源文件/源目录",
          "intrinsic_type": "Path",
          "required": true,
          "group": "源与目标",
          "default_type": "Path",
          "default_value": "",
          "presets": [],
          "description": "待处理的源路径"
        },
        {
          "name": "destination",
          "display_name": "目标路径",
          "intrinsic_type": "Path",
          "required": true,
          "group": "源与目标",
          "default_type": "Path",
          "default_value": "",
          "presets": [],
          "description": "解压输出目录或输出归档路径"
        },
        {
          "name": "filename",
          "display_name": "归档文件名称",
          "intrinsic_type": "String",
          "group": "压缩参数",
          "default_type": "String",
          "default_value": "archive.zip",
          "presets": [
            "archive.zip",
            "archive.tar.gz"
          ],
          "description": "压缩包文件名称"
        },
        {
          "name": "format",
          "display_name": "归档格式",
          "intrinsic_type": "Enum",
          "group": "压缩参数",
          "default_type": "String",
          "default_value": "zip",
          "presets": [
            "zip",
            "tar",
            "tar.gz"
          ],
          "description": "压缩格式"
        },
        {
          "name": "level",
          "display_name": "压缩等级",
          "intrinsic_type": "Integer",
          "group": "高级选项",
          "is_advanced": true,
          "default_type": "Number",
          "default_value": "6",
          "presets": [
            "0",
            "1",
            "6",
            "9"
          ],
          "description": "压缩级别 (0-9)"
        },
        {
          "name": "password",
          "display_name": "加密密码",
          "intrinsic_type": "Password",
          "group": "高级选项",
          "is_advanced": true,
          "default_type": "Password",
          "default_value": "",
          "presets": [],
          "description": "加密保护密码（若有）"
        },
        {
          "name": "overwrite",
          "display_name": "覆盖已存在文件",
          "intrinsic_type": "Boolean",
          "group": "高级选项",
          "is_advanced": true,
          "default_type": "Boolean",
          "default_value": "true",
          "presets": [
            "true",
            "false"
          ],
          "description": "是否允许覆盖"
